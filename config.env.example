# Copy this file to `config.env` and edit it for your setup.
# `config.env` is git-ignored and holds all machine/phone-specific values.
# Nothing personal should ever be committed to the scripts themselves.

# Path to the palera1n binary on your Mac (used for the checkm8 exploit + boot).
# Install it from https://palera.in — the default location below usually works.
PALERA1N="$HOME/.local/bin/palera1n"

# sshpass binary. `brew install hudochenkov/sshpass/sshpass` puts it in PATH.
# If you use a bundled copy (e.g. from an SSH ramdisk), give the full path.
SSHPASS_BIN="sshpass"

# Your iPhone's IP address while it is jailbroken and reachable over SSH.
# Needed only for `./android.sh deploy` and `./android.sh save` (writing the
# Android image to the phone and pulling /data back). Find it in the phone's
# Wi-Fi settings or your router. Leave empty if you only ever run `./android.sh`.
IOS_IP=""

# Root password of the jailbroken iOS. "alpine" is the universal default and
# almost certainly correct. Change it only if you changed it on the device.
IOS_SSH_PASS="alpine"
