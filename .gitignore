*.bin
*.apk
*.so
*.dmg
*.tar
*.tar.gz
# your saved Android /data and captures
data/
logs/
photos/

# --- OS / editor cruft ---
.DS_Store
*.swp
*.o

# device-specific userdata nonce (regenerated per device)
userdata-a16.conf
